<?xml version="1.0" encoding="utf-8"?>
<!--
  Bonsai-Icon: ein Beleg/Topf, aus dem ein kleiner Baum wächst.
  Bewusst komplett innerhalb der "sicheren Zone" (zentrale 66dp von 108dp,
  also x/y 21-87), damit nichts von runden/eckigen Launcher-Masken
  abgeschnitten wird. Kräftige Farben mit hohem Kontrast zum hellen
  Hintergrund, damit das Icon auch klein (z. B. 48dp) klar erkennbar bleibt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Topf/Beleg-Schale mit angedeutetem gezacktem Belegrand -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,66 L70,66 L70,80 L67,77 L64,80 L61,77 L58,80 L55,77 L52,80 L49,77 L46,80 L43,77 L40,80 L38,80 Z" />
    <!-- Andeutung von Druckzeilen auf dem Beleg -->
    <path android:fillColor="#2E6B4F" android:pathData="M43,70 L65,70 L65,72.5 L43,72.5 Z" />
    <path android:fillColor="#2E6B4F" android:pathData="M43,74.5 L58,74.5 L58,77 L43,77 Z" />

    <!-- Stamm -->
    <path
        android:fillColor="#6B4226"
        android:pathData="M51,53 L57,53 L58,66 L50,66 Z" />

    <!-- Baumkrone: drei überlappende Rundungen für Tiefe/Volumen -->
    <path
        android:fillColor="#2E6B4F"
        android:pathData="
            M27,45
            m-13,0
            a13,13 0 1,0 26,0
            a13,13 0 1,0 -26,0
            Z" />
    <path
        android:fillColor="#2E6B4F"
        android:pathData="
            M81,45
            m-13,0
            a13,13 0 1,0 26,0
            a13,13 0 1,0 -26,0
            Z" />
    <path
        android:fillColor="#7BC47F"
        android:pathData="
            M54,34
            m-16,0
            a16,16 0 1,0 32,0
            a16,16 0 1,0 -32,0
            Z" />
</vector>
